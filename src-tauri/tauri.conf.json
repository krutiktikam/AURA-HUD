{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Companion",
  "version": "1.0.0",
  "identifier": "com.ai-companion.device",
  "build": {
    "frontendDist": "../ui/dist",
    "devPath": "http://localhost:3000",
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Companion",
        "width": 400,
        "height": 120,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": false,
        "visible": true,
        "decorations": false,
        "transparent": false,
        "maximizable": false,
        "minimizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "AI Companion"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "languages": ["English"]
      }
    }
  }
}